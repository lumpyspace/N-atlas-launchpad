# ---------------------------------------------------------------------------
# N-ATLAS Launchpad backend configuration
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
# These variables describe how OUR backend reaches a self-hosted N-ATLAS
# inference server. N-ATLAS has NO official public API, so you must serve the
# model yourself and point NATLAS_ENDPOINT at it. See docs/N-ATLAS-INTEGRATION.md
# ---------------------------------------------------------------------------

# Provider — always "http" (the real N-ATLAS integration)
NATLAS_PROVIDER=http

# Base URL of your OpenAI-compatible N-ATLAS endpoint.
# Examples:
#   Ollama (local CPU):  http://localhost:11434/v1
#   vLLM / TGI (GPU):    http://your-gpu-host:8000/v1
#   HF Inference Endpoint: https://<your-endpoint>.endpoints.huggingface.cloud/v1
NATLAS_ENDPOINT=http://localhost:11434/v1

# Optional bearer token for the endpoint (e.g. a Hugging Face Inference Endpoint
# token). Leave blank for a local Ollama server that needs no auth.
# NEVER commit a real key — this file is only an example.
NATLAS_API_KEY=

# The model name your serving layer expects.
#   Ollama:            the tag you created, e.g. "n-atlas"
#   vLLM/TGI/HF:       the model id, e.g. "NCAIR1/N-ATLaS"
NATLAS_MODEL=n-atlas

# Request timeout (ms). CPU inference of an 8B model is slow — keep this generous.
NATLAS_REQUEST_TIMEOUT_MS=300000

# vLLM endpoints (e.g. Modal): repetition penalty sent with each request, matching
# the repeat_penalty in inference/Modelfile.8k. Leave empty for Ollama.
NATLAS_REPETITION_PENALTY=

# Port the backend listens on.
PORT=8788

# Extra models offered in the Compare grid, e.g. to benchmark N-ATLAS against
# its base model. Format: label|model[|endpoint[|ENV_VAR_HOLDING_API_KEY]],
# entries separated by ";". Endpoint defaults to NATLAS_ENDPOINT.
#   COMPARE_MODELS=Llama 3.1 8B (base)|llama3.1:8b
COMPARE_MODELS=

# Assistant model ("brain"): Groq does the thinking (writing sites, deciding each
# answer from the owner's facts); N-ATLAS reads and speaks Nigerian languages.
# Tried in order; leave all empty to run on N-ATLAS alone. Keys stay on the server.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Models tried in order: on the free plan each has its own per-minute limit.
# GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Backup when every Groq model is busy. Free key: https://aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash
# BRAIN_ORDER=groq,gemini
# Any other OpenAI-compatible endpoint:
# BRAIN_NAME=My model
# BRAIN_BASE_URL=https://example.com/v1
# BRAIN_MODEL=model-name
# BRAIN_API_KEY=
# Calls to the assistant model per day (a cost cap).
# BRAIN_DAILY_LIMIT=500

# Published sites are stored in Upstash Redis (free tier is plenty). Without it,
# a local server keeps them in backend/.data/sites.json; a public server can't publish.
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# Visitor messages per site per day, and new sites per visitor (IP) per day.
# SITE_DAILY_LIMIT=300
# PUBLISHES_PER_DAY=5

# Public hosting (set automatically on Vercel): locks the N-ATLAS settings and
# rate-limits each visitor (requests per minute / per hour).
# LAUNCHPAD_PUBLIC=1
# PUBLIC_PER_MINUTE=20
# PUBLIC_PER_HOUR=300
