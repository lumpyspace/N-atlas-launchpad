{
  "name": "n-atlas-forge-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend REST API for N-ATLAS Forge. Talks to a self-hosted N-ATLAS endpoint via a swappable provider abstraction.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "healthcheck": "tsx src/healthcheck.ts",
    "eval": "tsx src/eval/cli.ts",
    "test": "node --import tsx --test ../tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
